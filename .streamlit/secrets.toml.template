# Google Earth Engine — Service Account
GEE_SERVICE_ACCOUNT = "your-service-account@your-project.iam.gserviceaccount.com"

# Private key dari file JSON Service Account
# Salin seluruh isi field "private_key" dari file .json Anda
# (termasuk -----BEGIN RSA PRIVATE KEY----- dan -----END RSA PRIVATE KEY-----)
GEE_PRIVATE_KEY = """
-----BEGIN RSA PRIVATE KEY-----
MASUKKAN_PRIVATE_KEY_ANDA_DI_SINI
-----END RSA PRIVATE KEY-----
"""

# (Opsional) Project ID GEE Anda
GEE_PROJECT_ID = "your-gee-project-id"
